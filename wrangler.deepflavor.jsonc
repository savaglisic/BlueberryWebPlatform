{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blueberry-deepflavor-api",
  "main": "./worker/deepflavor.ts",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [
    {
      "pattern": "deepflavor-api.blueberry-web.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blueberry-web",
      "database_id": "3df15af4-49e5-4413-9fce-6e2f34e120c0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "blueberry-web-videos"
    }
  ]
}
